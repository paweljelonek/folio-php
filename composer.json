{
    "name": "foliophp/foliophp",
    "description": "Lightweight flat-file PHP framework. Write content in Markdown with YAML front matter, render it through Twig templates. URL routing mirrors the file structure. Built-in file cache, console command and full Docker support.",
    "type": "project",
    "authors": [
        {
            "name": "Pawel Jelonek",
            "email": "dev@jazzcat.pl"
        }
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "slim/slim": "^4.0",
        "slim/psr7": "^1.6",
        "php-di/php-di": "^7.0",
        "twig/twig": "^3.9",
        "symfony/dotenv": "^7.0",
        "symfony/console": "^7.0",
        "symfony/yaml": "^7.0",
        "league/commonmark": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/var-dumper": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/App"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests"
        }
    },
    "config": {
        "platform": {
            "php": "8.3"
        }
    }
}
